{
  "manifest_version": 3,
  "name": "Intégrer à SQUEAK",
  "version": "1.0.0",
  "description": "Ajoutez un site ou une page à votre application Squeak locale.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Intégrer à SQUEAK",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
